# MediaFlow 环境变量配置示例
# 复制此文件为 .env 并填入真实值

# ===== AI 文本服务（必填）=====
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ===== AI 图片生成（填入后自动生图，不填则用占位图）=====
OPENAI_API_KEY=your-openai-api-key-here
# 多个 Key 时批量并行生图会轮流使用，可突破单 Key 并发限制
# OPENAI_API_KEY_2=your-second-key-here
# OPENAI_API_KEY_3=your-third-key-here
# IMAGE_MODEL=gpt-image-2        # 默认 gpt-image-2
# IMAGE_SIZE=1024x1024           # 可选 1024x1024 / 1024x1792（竖图，适合手机）
# IMAGE_ENDPOINT=https://grsai.dakka.com.cn/v1/api/generate  # 自定义节点

# ===== JWT 密钥（建议修改为随机字符串）=====
SECRET_KEY=mediaflow-secret-key-change-in-production

# ===== 数据库（默认 SQLite，无需修改）=====
DATABASE_URL=sqlite:///./mediaflow.db

# ===== 邮箱配置（注册验证码功能必填）=====
# QQ 邮箱（推荐国内）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-qq@qq.com
SMTP_PASSWORD=your-qq-auth-code
SMTP_FROM_NAME=媒力 MediaFlow

# Gmail（推荐海外）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_NAME=媒力 MediaFlow

# ===== 微博关键词搜索（可选，不填则降级为热搜榜）=====
# 获取方法：浏览器登录 weibo.com → F12 → Network → 任意请求 → 复制 Cookie 整行
WEIBO_COOKIE=
# 抖音关键词搜索（可选，不填则降级为热搜榜）
# 获取方法：浏览器登录 douyin.com → F12 → Network → 任意请求 → 复制 Cookie 整行
# 需包含 sessionid 和 ttwid 字段
DOUYIN_COOKIE=

# ===== 小红书 MCP 服务地址（本地运行）=====
XIAOHONGSHU_MCP_URL=http://localhost:18060
MULTI_ACCOUNT_MANAGER_URL=http://localhost:8080

# ===== 支付配置（可选）=====
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ===== SQL 调试（开发时可开启）=====
SQL_ECHO=false

# 📧 QQ 邮箱授权码获取：
# 1. 登录 mail.qq.com → 设置 → 账户
# 2. 开启 IMAP/SMTP 服务 → 生成授权码
