# ===== MediaFlow 在线版配置 =====
# 复制成 deploy/online.env（Docker）或 /etc/mediaflow/mediaflow.env（不用 Docker），然后改值。
# 这个文件里有密钥：chmod 600，不要提交到 git。

# 开启登录（不设就是本地版：不用登录、谁打开都能用）
MEDIAFLOW_AUTH=password
# 登录签名密钥，随便一串长随机字符；生成：openssl rand -hex 32 。改了它所有人要重新登录
MEDIAFLOW_SECRET=
# 管理员账号：只在第一次启动时用来创建管理员；之后改密码请在页面右上角或用 mediaflow reset-password
MEDIAFLOW_ADMIN_USER=admin
MEDIAFLOW_ADMIN_PASSWORD=

# 每个成员每天的额度（管理员不限）；0 表示不限
MEDIAFLOW_DAILY_WRITES=20
MEDIAFLOW_DAILY_CHATS=200

# 模型 Key：可以在这里填，也可以留空、上线后用管理员账号在页面里填（页面里填的会存在数据目录）
DEEPSEEK_API_KEY=
IMAGE_API_KEY=

# 域名（给 Caddy 用，Docker 方式才需要），例如 mf.example.com
DOMAIN=
