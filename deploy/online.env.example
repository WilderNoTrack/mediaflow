# ===== MediaFlow 在线版配置 =====
# 复制成 deploy/online.env（Docker）或 /etc/mediaflow/mediaflow.env（不用 Docker），然后改值。
# 这个文件里有密钥：chmod 600，不要提交到 git。

# ── 模式 ──
# demo     = 演示版（推荐现阶段用）：打开就能用、不用注册登录，大家共用一份数据；
#            Key 和平台连接锁住，只有输过管理员口令的浏览器能改；额度是全站共用的
# password = 登录版：管理员给每人开账号，数据按人隔离，每人有额度
MEDIAFLOW_AUTH=demo

# 演示版的管理员口令：上线后打开 https://你的域名/admin 输入它，这个浏览器就能填 Key、扫码连平台
# 生成：openssl rand -hex 16
MEDIAFLOW_ADMIN_TOKEN=

# 每天额度。demo：全站每天一共能写几篇 / 聊几句（你自己用也算）；password：每个成员每天的量。0 = 不限
MEDIAFLOW_DAILY_WRITES=50
MEDIAFLOW_DAILY_CHATS=500

# 模型 Key：可以在这里填，也可以留空、上线后在 /admin 解锁后到页面里填
DEEPSEEK_API_KEY=
IMAGE_API_KEY=

# 域名（给 Caddy 用，Docker 方式才需要），例如 mf.example.com
DOMAIN=

# ── 以后切到登录版（MEDIAFLOW_AUTH=password）才需要 ──
# MEDIAFLOW_SECRET=          # 登录签名密钥：openssl rand -hex 32
# MEDIAFLOW_ADMIN_USER=admin # 首次启动时创建的管理员
# MEDIAFLOW_ADMIN_PASSWORD=
