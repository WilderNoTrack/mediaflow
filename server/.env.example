# ── 必填 ─────────────────────────────────────────────
# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── 可选：大模型 ─────────────────────────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 可选：AI 配图（不填则跳过配图，文案照常生成）──────
# IMAGE_API_KEY=
# IMAGE_ENDPOINT=https://grsai.dakka.com.cn/v1/api/generate
# IMAGE_MODEL=gpt-image-2
# IMAGE_SIZE=1024x1536

# ── 可选：选题来源 ───────────────────────────────────
# 配置后微博可按关键词搜索，否则只用热搜榜
# WEIBO_COOKIE=

# ── 可选：运行参数 ───────────────────────────────────
# MEDIAFLOW_DATA_DIR=./data       # 数据库与图片存放目录
# MEDIAFLOW_PORT=8765
# MEDIAFLOW_OPEN_BROWSER=true
