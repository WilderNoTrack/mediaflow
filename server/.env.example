# ── 必填 ─────────────────────────────────────────────
# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── 可选：大模型 ─────────────────────────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_VISION_MODEL=deepseek-flash   # 看图（学配图模板、出图自检）；留空就不看图

# ── 可选：AI 配图（不填则跳过配图，文案照常生成）──────
# IMAGE_NEXT_API_KEY=              # openai-next 生图，优先用；额度用完自动换下面的 grsai
# IMAGE_NEXT_BASE_URL=https://api.openai-next.com/v1
# IMAGE_API_KEY=                   # grsai 生图（备用）
# IMAGE_ENDPOINT=https://grsai.dakka.com.cn/v1/api/generate
# IMAGE_MODEL=gpt-image-2.5          # 或 nano-banana-2.1；推荐在界面「AI 配图」里填 Key、选模型


# ── 可选：选题来源 ───────────────────────────────────
# 推荐在界面「数据来源」里配置（会覆盖这里的值）；不配置的平台退回热榜
# XHS_COOKIE=                   # 小红书 Cookie（推荐在界面扫码登录）
# ZHIHU_ACCESS_SECRET=          # 知乎开放平台 Access Secret
# QIANFAN_API_KEY=              # 百度千帆 API Key（AI 搜索）
# DOUYIN_COOKIE=                # 抖音网页版登录 Cookie
# BILIBILI_COOKIE=              # B站 Cookie（也可在界面扫码登录，自动续期）
# WEIBO_COOKIE=                 # 微博网页版登录 Cookie

# ── 可选：运行参数 ───────────────────────────────────
# MEDIAFLOW_DATA_DIR=./data       # 数据库与图片存放目录
# MEDIAFLOW_PORT=8765
# MEDIAFLOW_OPEN_BROWSER=true

# ── 部署到服务器（详见 DEPLOY.md）──
# MEDIAFLOW_AUTH=demo          # demo=演示版（免登录、共用数据、设置锁住）；password=登录版；不设=本地版
# MEDIAFLOW_ADMIN_TOKEN=       # 演示版管理员口令：打开 /admin 输入后能改设置
# MEDIAFLOW_DAILY_WRITES=50    # 演示版：全站每天写几篇；登录版：每人每天几篇（0=不限）
# MEDIAFLOW_DAILY_CHATS=500
